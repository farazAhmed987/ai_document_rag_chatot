# Environment template (SRD Section 13). Never put real secrets in Git.
APP_ENV=development

# Operational and analytics DB URLs; supplied privately in .env.
DATABASE_URL=
ANALYTICS_DATABASE_URL=

# Restricted role assumed by tenant_session; do not use BYPASSRLS login at runtime.
DB_RUNTIME_ROLE=rag_app

# LLM settings (not used until a later phase).
LLM_PROVIDER=gemini
API_KEY=
MODEL_NAME=
REWRITE_MODEL_NAME=

# Embedding/reranking settings (models not installed in Part A).
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# File storage.
STORAGE_BACKEND=local
STORAGE_PATH=
SUPABASE_URL=
MAX_UPLOAD_MB=20
MAX_PAGES=300
MAX_EXTRACTED_CHARS=5000000
MAX_ZIP_UNCOMPRESSED_MB=200

# Later-phase ingestion and retrieval controls.
CHUNK_TOKENS=500
CHUNK_OVERLAP=60
DENSE_K=20
KEYWORD_K=20
RERANK_TOP_N=5
MIN_RELEVANCE=
HISTORY_TURNS=6

# Web/observability.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Future analytics safety settings; no analytics logging code in this round.
QA_LOGGING_ENABLED=true
QA_RETENTION_DAYS=365
QA_SPILL_PATH=data/qa_spill
