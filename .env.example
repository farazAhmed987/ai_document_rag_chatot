# Phase 0 environment template.
# SRD Section 13 and the operational/analytics DB deviation.
# Copy this file to .env in the repository root.
# Never commit real credentials.

# Application environment: development, test, or production.
APP_ENV=development

# Operational PostgreSQL database (leave empty until Phase 2).
# Example: postgresql://user:password@host:5432/database
DATABASE_URL=

# Separate analytics PostgreSQL database (Phase 2).
# Example: postgresql://user:password@host:5432/analytics
ANALYTICS_DATABASE_URL=

# External LLM provider. Not used during Phases 0 to 3.
LLM_PROVIDER=gemini

# API key for the configured LLM provider.
API_KEY=

# Generation model identifier, supplied by the provider.
MODEL_NAME=

# Query rewrite model identifier, supplied by the provider.
REWRITE_MODEL_NAME=

# Local embedding model. Installed in a later phase.
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# Local reranking model. Installed in a later phase.
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Storage backend: local initially.
STORAGE_BACKEND=local

# Storage directory. Empty means the repository data directory.
STORAGE_PATH=

# Optional Supabase service URL; no Supabase SDK is used.
SUPABASE_URL=

# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB=20

# Target chunk length in tokens; used in a later phase.
CHUNK_TOKENS=500

# Chunk overlap in tokens; used in a later phase.
CHUNK_OVERLAP=60

# Number of dense retrieval candidates.
DENSE_K=20

# Number of keyword retrieval candidates.
KEYWORD_K=20

# Number of candidates returned after reranking.
RERANK_TOP_N=5

# Minimum retrieval relevance score; calibrate later.
MIN_RELEVANCE=

# Number of previous messages used for query rewriting.
HISTORY_TURNS=6

# Comma-separated CORS origins, parsed by the future API layer.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Structured logging level.
LOG_LEVEL=INFO
